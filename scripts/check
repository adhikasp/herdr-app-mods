#!/usr/bin/env bash
# Load and render every mod once with `herdr-app check`, then run the unit tests.
# Needs the Herdr app installed (it does not need a window).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fail=0
for dir in "$here"/herdr-mods/*/mods/*/; do
  herdr-app check "${dir%/}" || fail=1
done
"$here"/scripts/sync-shared --check || fail=1
node --test "$here"/test/*.test.js || fail=1
exit $fail
